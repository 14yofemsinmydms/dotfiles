layout {

    focus-ring {
        active-color   "#bcc6df"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bcc6df"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#bcc6df"
        inactive-color "#3d475b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bcc6df80"
    }
}

recent-windows {
    highlight {
        active-color "#bcc6df"
        urgent-color "#ffb4ab"
    }
}
